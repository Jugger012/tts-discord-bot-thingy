# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
# Optional: restrict bot to a single guild during development
DISCORD_GUILD_ID=

# ─── LLM Backend ──────────────────────────────────────────────────────────────
# Options: gemini | openai
LLM_BACKEND=gemini
LLM_MODEL=gemini-3.8-flash

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── TTS Backend ──────────────────────────────────────────────────────────────
# Options: xtts | f5 | elevenlabs | cartesia
TTS_BACKEND=xtts

# ElevenLabs (TTS_BACKEND=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=
# Leave blank to use reference audio upload instead of a pre-existing voice ID

# Cartesia (TTS_BACKEND=cartesia)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=

# ─── STT Backend ──────────────────────────────────────────────────────────────
# Options: faster-whisper | openai
STT_BACKEND=faster-whisper
# Model sizes: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=base
# Device: cpu | cuda | auto
WHISPER_DEVICE=auto

# ─── Voice Reference Audio ────────────────────────────────────────────────────
REFERENCE_AUDIO_PATH=assets/reference_voice.wav

# ─── Conversation Context ─────────────────────────────────────────────────────
# Number of past turns to keep in the rolling context window
CONTEXT_WINDOW_SIZE=20

# ─── VAD (Voice Activity Detection) ──────────────────────────────────────────
# Milliseconds of silence before a speech segment is considered finished
VAD_SILENCE_THRESHOLD_MS=1200
# WebRTC VAD aggressiveness: 0 (least aggressive) to 3 (most aggressive)
VAD_AGGRESSIVENESS=2

# ─── Bot Persona ──────────────────────────────────────────────────────────────
BOT_NAME=Aria
BOT_PERSONA=You are Aria, a witty, concise, and friendly AI assistant. You speak naturally and conversationally, as if talking to a friend. Keep responses short and punchy — no more than 2-3 sentences unless specifically asked for detail.

# ─── Text-to-Voice Hybrid Mode ────────────────────────────────────────────────
# Set to the text channel ID to enable hybrid mode (bot reads text channel and speaks responses)
HYBRID_TEXT_CHANNEL_ID=

# ─── Audio Playback ───────────────────────────────────────────────────────────
# Output volume multiplier (1.0 = original, 0.5 = half volume)
PLAYBACK_VOLUME=0.9
